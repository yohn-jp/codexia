/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'

/desktop*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:

/index.html
  Cache-Control: no-store

/desktop/index.html
  Cache-Control: no-store

/desktop/update-identity.json
  Cache-Control: no-store

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/desktop/assets/*
  Cache-Control: public, max-age=31536000, immutable

/oauth/login
  Cache-Control: no-store

/oauth/consent
  Cache-Control: no-store

/oauth/oauth-login.html
  Cache-Control: no-store

/oauth/oauth-consent.html
  Cache-Control: no-store

/oauth/assets/*
  Cache-Control: public, max-age=31536000, immutable

/r/*
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
