{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "codexia-frontend",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-08",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../app/dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/desktop*",
      "/mobile*",
      "/r/*",
      "!/assets/*",
      "!/desktop/assets/*",
      "!/mobile/assets/*"
    ],
    "not_found_handling": "none"
  }
}
