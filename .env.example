# PostgreSQL is required for all authoring. Apply checksummed schema changes before serving traffic.
CODEXIA_DATABASE_URL=
CODEXIA_DATABASE_MIGRATE_ON_START=0

# Standalone Better Auth settings from the protected enrollment and provisioning procedure.
# See docs/deployment/ANSIBLE-AUTH-RUNTIME.sdoc. Supply secret values through protected runtime configuration.
CODEXIA_AUTH_DATABASE_URL=
CODEXIA_AUTH_SECRET=
CODEXIA_PUBLIC_ORIGIN=https://codexia.example.com
CODEXIA_OAUTH_INTROSPECTION_CLIENT_ID=
CODEXIA_OAUTH_INTROSPECTION_CLIENT_SECRET=
CODEXIA_OAUTH_OWNER_SUBJECT=
CODEXIA_OAUTH_OWNER_CLIENT_IDS=
# The API audience defaults to CODEXIA_PUBLIC_ORIGIN followed by /api.
# CODEXIA_API_AUDIENCE=https://codexia.example.com/api
# Optional upstream OIDC. Set all three for federation or omit all three for Passkey-only sign-in.
# CODEXIA_OIDC_ISSUER=https://identity.example.com
# CODEXIA_OIDC_CLIENT_ID=
# CODEXIA_OIDC_CLIENT_SECRET=
# MCP admission defaults to no clients.
# CODEXIA_OAUTH_MCP_CLIENT_IDS=<comma-separated administratively registered MCP client IDs>
# Keep this disjoint from CODEXIA_OAUTH_OWNER_CLIENT_IDS; Dynamic Client Registration remains disabled.
# When MCP clients are enabled, configure each client and its existing project IDs as a JSON object.
# CODEXIA_OAUTH_MCP_PROJECT_ASSIGNMENTS='{"mcp-client-id":["project-id"]}'
# See docs/architecture/MCP-OAUTH.sdoc for the MCP client and project assignment rules.

# Select the same profile when building and starting: core or full.
CODEXIA_PROFILE=core
CODEXIA_DATA_DIR=./data
# Private usage/job history; keep it persistent independently of module cache.
CODEXIA_USAGE_DIR=./host-history
# Set trust proxy only behind a trusted proxy that replaces X-Forwarded-Proto.
# CODEXIA_TRUST_PROXY=1
HOST=127.0.0.1
PORT=3000
