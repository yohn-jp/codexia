# Generate a unique secret with: openssl rand -hex 32
# Existing SCRIPTORIUM_* deployment settings remain accepted; CODEXIA_* wins if both are set.
CODEXIA_AUTH_TOKEN=
CODEXIA_DATA_DIR=./data
# PostgreSQL is required for all authoring. Apply checksummed schema changes before serving traffic.
CODEXIA_DATABASE_URL=
CODEXIA_DATABASE_MIGRATE_ON_START=0
# Select the same profile when building and starting: core or full.
CODEXIA_PROFILE=core
# Hosted mode also requires the existing PostgreSQL project explicitly assigned to this runtime.
# CODEXIA_HOSTED_PROJECT_ID=
# Private usage/job history; keep it persistent independently of module cache.
CODEXIA_USAGE_DIR=./host-history
HOST=127.0.0.1
PORT=3000
