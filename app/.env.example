# Optional public Web OAuth client configuration. These values are embedded in
# static assets; never add a client secret or access token here. The issuer is
# the embedded Better Auth OAuth Provider, not the upstream OIDC provider.
# Confirm endpoints against its OAuth authorization-server metadata at
# https://<codexia-origin>/.well-known/oauth-authorization-server/api/auth
# Register both exact callback URIs on one public client with PKCE S256 and
# token endpoint auth method `none`.
# VITE_CODEXIA_OAUTH_ISSUER=https://<codexia-origin>/api/auth
# VITE_CODEXIA_OAUTH_CLIENT_ID=<registered public Web client ID>
# This exact resource must be enabled and linked to the Web client server-side.
# VITE_CODEXIA_API_AUDIENCE=https://<codexia-origin>/api
# Replace <codexia-origin> with the operator-approved Web origin.
# VITE_CODEXIA_OAUTH_DESKTOP_REDIRECT_URI=https://<codexia-origin>/desktop
# VITE_CODEXIA_OAUTH_MOBILE_REDIRECT_URI=https://<codexia-origin>/mobile
# VITE_CODEXIA_OAUTH_SCOPES=openid codexia:api
# Leave unset for the current same-origin /api routing. Set only to an
# explicitly approved HTTPS API origin for bearer-only API data requests.
# Cross-origin Better Auth login/session routing is not currently accepted.
# VITE_CODEXIA_API_ORIGIN=https://<operator-approved-api-origin>
# Native iOS only: public HTTPS reader-site origin for publication share links.
# Unset disables native share-link creation; it never falls back to WebView URL.
# VITE_CODEXIA_PUBLIC_READER_ORIGIN=https://<operator-approved-reader-origin>
