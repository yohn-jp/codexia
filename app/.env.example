# Optional public browser OAuth configuration. These values are public and are
# embedded in the static app; never add a client secret or access token here.
# Register both exact redirect URIs for the same public Web client.
# VITE_CODEXIA_OAUTH_AUTHORIZATION_ENDPOINT=https://id.example.com/oauth2/authorize
# VITE_CODEXIA_OAUTH_TOKEN_ENDPOINT=https://id.example.com/oauth2/token
# VITE_CODEXIA_OAUTH_CLIENT_ID=<registered public Web client ID>
# VITE_CODEXIA_API_AUDIENCE=https://api.example.com
# VITE_CODEXIA_OAUTH_DESKTOP_REDIRECT_URI=https://codexia.yohn.jp/desktop
# VITE_CODEXIA_OAUTH_MOBILE_REDIRECT_URI=https://codexia.yohn.jp/mobile
# VITE_CODEXIA_OAUTH_SCOPES=openid codexia:api
# Unset to retain the current same-origin /api routing. Set only to the
# operator-approved HTTPS API origin when the Tunnel/Access route is ready.
# VITE_CODEXIA_API_ORIGIN=https://api.example.com
