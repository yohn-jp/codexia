{
  "name": "@codexia/app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && node scripts/build-views.mjs",
    "generate:http": "node scripts/generate-http.mjs",
    "check-generated:http": "node scripts/generate-http.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run check-generated:http && node --import tsx --test 'src/**/*.test.{ts,tsx}'"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "catalog:production",
    "@better-auth/passkey": "catalog:production",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/merge": "6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@codexia/contracts": "workspace:*",
    "@codexia/persistence-contracts": "workspace:*",
    "@headless-tree/core": "1.8.0",
    "@headless-tree/react": "1.8.0",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@xstate/react": "6.1.0",
    "better-auth": "catalog:production",
    "oauth4webapi": "3.8.9",
    "react": "catalog:production",
    "react-dom": "catalog:production",
    "react-resizable-panels": "4.24.1",
    "react-router-dom": "7.18.6",
    "xstate": "5.33.4",
    "zod": "catalog:production"
  },
  "devDependencies": {
    "@types/react": "catalog:development",
    "@types/react-dom": "catalog:development",
    "@vanilla-extract/css": "1.21.3",
    "@vanilla-extract/recipes": "0.5.7",
    "@vanilla-extract/vite-plugin": "5.2.6",
    "@vitejs/plugin-react": "^6.3.0",
    "orval": "8.49.0",
    "vite": "^8.3.8",
    "yaml": "catalog:production"
  }
}
