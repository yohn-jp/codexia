{
  "output": {
    "style": "json",
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "compress": false,
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": false,
    "truncateBase64": false,
    "copyToClipboard": false,
    "git": {
      "sortByChanges": false,
      "includeDiffs": false,
      "includeLogs": false
    }
  },
  "ignore": {
    "useGitignore": false,
    "useDotIgnore": false,
    "useDefaultPatterns": false,
    "customPatterns": []
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
