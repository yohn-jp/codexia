{
  "name": "@codexia/persistence-postgres",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./knowledge-merge": {
      "types": "./dist/knowledge-merge.d.ts",
      "import": "./dist/knowledge-merge.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --import tsx --test src/*.test.ts",
    "migrate": "pnpm run build && node dist/migrate.js"
  },
  "dependencies": {
    "@codexia/persistence-contracts": "workspace:*",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  },
  "files": [
    "dist",
    "migrations"
  ]
}
