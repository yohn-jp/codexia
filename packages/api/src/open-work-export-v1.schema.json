{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codexia open work ZIP v1",
  "$ref": "#/$defs/manifest",
  "$defs": {
    "manifest": {
      "type": "object",
      "required": [
        "format",
        "projectId",
        "snapshotVersion",
        "excludedCounts",
        "files"
      ],
      "properties": {
        "format": {
          "const": "codexia-open-work/v1"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "snapshotVersion": {
          "type": "integer",
          "minimum": 0
        },
        "excludedCounts": {
          "type": "object",
          "required": [
            "settings",
            "moduleRecords",
            "authorityRecords",
            "authorAttribution"
          ],
          "properties": {
            "settings": {
              "type": "integer",
              "minimum": 0
            },
            "moduleRecords": {
              "type": "integer",
              "minimum": 0
            },
            "authorityRecords": {
              "type": "integer",
              "minimum": 0
            },
            "authorAttribution": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "title",
        "settings",
        "version",
        "createdAt",
        "updatedAt",
        "documents"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "title": {
          "type": "string"
        },
        "settings": {
          "type": "object"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "parentId",
              "kind",
              "title",
              "orderKey",
              "headRevisionId",
              "version",
              "createdAt",
              "updatedAt",
              "deletedAt"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "parentId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "kind": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "orderKey": {
                "type": "string"
              },
              "headRevisionId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "version": {
                "type": "integer",
                "minimum": 0
              },
              "createdAt": {
                "type": "string"
              },
              "updatedAt": {
                "type": "string"
              },
              "deletedAt": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "documentId",
          "parentRevisionId",
          "createdAt",
          "authorId",
          "sha256",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "documentId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "parentRevisionId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "authorId": {
            "enum": [
              "owner",
              null
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "moduleRecords": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "moduleId",
          "key",
          "value"
        ],
        "properties": {
          "moduleId": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "value": {
            "type": "object"
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "required": [
        "nodes",
        "aliases",
        "relations"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "name",
              "attributes",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "type": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "attributes": {
                "type": "object"
              },
              "status": {
                "type": "string"
              }
            }
          }
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "nodeId",
              "surface",
              "normalized",
              "scope",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "nodeId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "surface": {
                "type": "string"
              },
              "normalized": {
                "type": "string"
              },
              "scope": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": "string"
              }
            }
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "sourceId",
              "targetId",
              "type",
              "attributes",
              "validity",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "sourceId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "targetId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "type": {
                "type": "string"
              },
              "attributes": {
                "type": "object"
              },
              "validity": {
                "type": "object"
              },
              "status": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "anchors",
        "mentions",
        "assertions",
        "assertionEvidence",
        "unresolved"
      ],
      "properties": {
        "anchors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "documentId",
              "revisionId",
              "fromUtf16",
              "toUtf16",
              "quoteSha256",
              "status",
              "revisionIncluded"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "documentId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "revisionId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "fromUtf16": {
                "type": "integer",
                "minimum": 0
              },
              "toUtf16": {
                "type": "integer",
                "minimum": 0
              },
              "quoteSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "status": {
                "type": "string"
              },
              "revisionIncluded": {
                "type": "boolean"
              }
            }
          }
        },
        "mentions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "evidenceId",
              "nodeId",
              "status",
              "source"
            ],
            "properties": {
              "evidenceId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "nodeId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "status": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            }
          }
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "proposition",
              "modality",
              "perspective",
              "narrativeTime",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "proposition": {
                "type": "object"
              },
              "modality": {
                "type": "string"
              },
              "perspective": {
                "type": "string"
              },
              "narrativeTime": {
                "type": "object"
              },
              "status": {
                "type": "string"
              }
            }
          }
        },
        "assertionEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "assertionId",
              "evidenceId",
              "role"
            ],
            "properties": {
              "assertionId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "evidenceId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "role": {
                "type": "string"
              }
            }
          }
        },
        "unresolved": {
          "type": "object",
          "required": [
            "anchors",
            "mentions",
            "assertionEvidence"
          ],
          "properties": {
            "anchors": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "mentions": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "assertionEvidence": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
