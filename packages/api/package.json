{
  "name": "@codexia/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./native-knowledge-merge-service": {
      "types": "./dist/native-knowledge-merge-service.d.ts",
      "import": "./dist/native-knowledge-merge-service.js"
    },
    ".": "./dist/server.js",
    "./native-knowledge-service": {
      "types": "./dist/native-knowledge-service.d.ts",
      "import": "./dist/native-knowledge-service.js"
    },
    "./native-knowledge-actions": {
      "types": "./dist/native-knowledge-actions.d.ts",
      "import": "./dist/native-knowledge-actions.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @codexia/http-contract generate && tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @codexia/http-contract generate && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/*.test.js && pnpm --filter @codexia/app generate:http && node --import tsx --test --test-concurrency=1 test/better-auth.integration.test.ts test/passkey-bootstrap.acceptance.test.ts test/persistence-author-api.integration.test.ts test/persistence-route-admission.integration.test.ts test/backup-console.integration.test.ts",
    "test:passkey-acceptance": "pnpm run build && node scripts/run-passkey-acceptance.mjs",
    "start": "node dist/server.js",
    "migrate:auth": "node dist/migrate-auth.js",
    "maintain:snapshot-projections": "node dist/maintain-snapshot-projections.js",
    "grant:passkey-owner": "node dist/grant-passkey-owner.js",
    "grant:passkey-owner-recovery": "node dist/grant-passkey-owner-recovery.js",
    "verify:auth-clients": "node dist/verify-auth-clients.js",
    "prune:auth-revocations": "node dist/prune-auth-revocations.js"
  },
  "dependencies": {
    "@better-auth/core": "1.7.26",
    "@better-auth/oauth-provider": "catalog:production",
    "@better-auth/passkey": "catalog:production",
    "@codexia/contracts": "workspace:*",
    "@codexia/core": "workspace:*",
    "@codexia/module-runtime": "workspace:*",
    "@codexia/persistence-contracts": "workspace:*",
    "@codexia/persistence-postgres": "workspace:*",
    "@fastify/ajv-compiler": "4.0.8",
    "@fastify/rate-limit": "11.3.0",
    "@simplewebauthn/server": "13.3.3",
    "@zip.js/zip.js": "2.25.0",
    "better-auth": "catalog:production",
    "fastify": "^5.12.8",
    "jose": "6.2.18",
    "jsonc-parser": "3.3.1",
    "pg": "8.23.1",
    "zod": "catalog:production"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@codexia/http-contract": "workspace:*",
    "@types/pg": "8.23.1",
    "@codexia/module-mcp": "workspace:*"
  }
}
