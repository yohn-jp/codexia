{
  "name": "@codexia/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./dist/server.js",
    "./native-knowledge-service": {
      "types": "./dist/native-knowledge-service.d.ts",
      "import": "./dist/native-knowledge-service.js"
    },
    "./native-knowledge-merge-service": {
      "types": "./dist/native-knowledge-merge-service.d.ts",
      "import": "./dist/native-knowledge-merge-service.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/*.test.js",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@codexia/core": "workspace:*",
    "@codexia/contracts": "workspace:*",
    "@codexia/persistence-contracts": "workspace:*",
    "@codexia/persistence-postgres": "workspace:*",
    "@codexia/module-runtime": "workspace:*",
    "fastify": "^5.3.2",
    "zod": "3.25.76"
  },
  "files": [
    "dist"
  ]
}
