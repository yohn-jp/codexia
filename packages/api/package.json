{
  "name": "@codexia/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./dist/server.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/*.test.js",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@codexia/persistence-contracts": "workspace:*",
    "@codexia/persistence-postgres": "workspace:*",
    "fastify": "^5.3.2"
  },
  "files": [
    "dist"
  ]
}
