{
  "name": "@codexia/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./native-knowledge-merge-service": {
      "types": "./dist/native-knowledge-merge-service.d.ts",
      "import": "./dist/native-knowledge-merge-service.js"
    },
    ".": "./dist/server.js",
    "./native-knowledge-service": {
      "types": "./dist/native-knowledge-service.d.ts",
      "import": "./dist/native-knowledge-service.js"
    },
    "./native-knowledge-actions": {
      "types": "./dist/native-knowledge-actions.d.ts",
      "import": "./dist/native-knowledge-actions.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/*.test.js && node --import tsx --test test/better-auth.integration.test.ts",
    "start": "node dist/server.js",
    "migrate:auth": "node dist/migrate-auth.js",
    "verify:auth-clients": "node dist/verify-auth-clients.js",
    "prune:auth-revocations": "node dist/prune-auth-revocations.js"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.26",
    "@codexia/contracts": "workspace:*",
    "@codexia/core": "workspace:*",
    "@codexia/module-runtime": "workspace:*",
    "@codexia/persistence-contracts": "workspace:*",
    "@codexia/persistence-postgres": "workspace:*",
    "better-auth": "1.7.26",
    "fastify": "^5.12.8",
    "jose": "6.2.17",
    "pg": "8.16.3",
    "zod": "4.6.7"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/pg": "8.15.6"
  }
}
