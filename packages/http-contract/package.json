{
  "name": "@codexia/http-contract",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "pnpm run check-generated && tsc -p tsconfig.json && pnpm run lint:generated",
    "check-breaking": "pnpm run generate:openapi && node scripts/check-breaking.mjs",
    "check-generated": "pnpm run generate && node scripts/generate-fastify.mjs --check",
    "lint": "pnpm run generate:openapi && pnpm run lint:generated",
    "typecheck": "tsp compile src/main.tsp --no-emit && tsc -p tsconfig.json",
    "test": "pnpm run check-generated && node --test test/*.test.mjs test/*.test.ts && pnpm run lint:generated && node scripts/check-breaking.mjs",
    "generate": "node scripts/generate-fastify.mjs",
    "generate:openapi": "node scripts/generate-openapi.mjs",
    "lint:generated": "redocly lint openapi/codexia.openapi.yaml --config redocly.yaml"
  },
  "devDependencies": {
    "@redocly/cli": "2.83.0",
    "@typespec/compiler": "1.18.0",
    "@typespec/http": "1.18.0",
    "@typespec/openapi": "1.18.0",
    "@typespec/openapi3": "1.18.0",
    "fastify": "5.12.8",
    "yaml": "2.9.1"
  }
}
