{
  "name": "@codexia/module-assistant",
  "private": true,
  "version": "0.1.0",
  "codexiaDisplay": {
    "name": "Writing assistant",
    "description": "Local manuscript analysis, source-bound prompts for external MCP clients, and reviewable author proposals."
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-prompts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@codexia/contracts": "workspace:*",
    "@codexia/module-runtime": "workspace:*",
    "@codexia/module-story": "workspace:*",
    "@codexia/module-nlp": "workspace:*",
    "@codexia/module-diagnostics": "workspace:*",
    "@codexia/module-semantic": "workspace:*",
    "@codexia/module-speaker": "workspace:*",
    "zod": "4.6.7",
    "yaml": "^2.9.1"
  },
  "codexiaModule": {
    "id": "assistant",
    "version": "0.1.0",
    "contractVersion": 1,
    "dependencies": [
      "story",
      "nlp",
      "diagnostics",
      "semantic",
      "speaker"
    ],
    "provides": [],
    "requires": [],
    "serverEntry": "./dist/index.js",
    "browserEntry": "./dist/browser.js",
    "statePaths": [],
    "locality": "local",
    "optionalRequires": []
  }
}
