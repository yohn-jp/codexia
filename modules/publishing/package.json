{
  "name": "@codexia/module-publishing",
  "private": true,
  "version": "0.1.0",
  "codexiaDisplay": {
    "name": "Publishing",
    "description": "Manage publication metadata, prepare exports, and control reader sharing."
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@codexia/contracts": "workspace:*",
    "yaml": "catalog:production",
    "jszip": "^3.10.2"
  },
  "codexiaModule": {
    "id": "publishing",
    "version": "0.1.0",
    "contractVersion": 1,
    "dependencies": [],
    "provides": [],
    "requires": [],
    "serverEntry": "./dist/index.js",
    "statePaths": [
      "meta/scriptorium/modules/publishing"
    ],
    "locality": "local",
    "http": [
      { "id": "publishing.http.public-share", "path": "share/:token", "methods": ["GET"], "access": "public", "effect": "read" },
      { "id": "publishing.http.public-share-scene", "path": "share/:token/scenes/:sceneId", "methods": ["GET"], "access": "public", "effect": "read" }
    ],
    "browserEntry": "./dist/browser.js"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
