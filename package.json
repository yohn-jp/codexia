{
  "name": "codexia",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build:backend": "pnpm --filter @codexia/api... build",
    "build": "pnpm build:backend && pnpm --filter @codexia/app build",
    "build:frontend": "pnpm --filter @codexia/persistence-contracts build && pnpm --filter @codexia/app build",
    "typecheck": "pnpm build:backend && pnpm --filter @codexia/api typecheck && pnpm --filter @codexia/app typecheck",
    "typecheck:tests": "pnpm typecheck",
    "typecheck:safety": "tsc -p tsconfig.safety.json",
    "test": "pnpm --recursive --workspace-concurrency=1 test && pnpm test:scripts",
    "test:scripts": "node --test 'scripts/*.test.mjs'",
    "audit:core": "node scripts/audit-runtime-deps.mjs",
    "start": "node packages/api/dist/server.js",
    "test:e2e": "pnpm build && playwright test --config tests/e2e/playwright.config.ts",
    "typecheck:deployment": "tsc -p edge/frontend/tsconfig.json --noEmit",
    "test:deployment": "node --import tsx --test 'edge/frontend/test/*.test.ts'",
    "verify:deployment": "node scripts/verify-deployment-config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2"
  }
}
