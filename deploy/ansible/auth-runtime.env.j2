# Nonsecret Better Auth runtime settings. Secret values are Podman secrets.
CODEXIA_PUBLIC_ORIGIN={{ codexia_public_origin }}
CODEXIA_OIDC_ISSUER={{ codexia_oidc_issuer }}
CODEXIA_OIDC_CLIENT_ID={{ codexia_oidc_client_id }}
CODEXIA_OAUTH_INTROSPECTION_CLIENT_ID={{ codexia_oauth_introspection_client_id }}
CODEXIA_OAUTH_OWNER_SUBJECT={{ codexia_oauth_owner_subject }}
CODEXIA_OAUTH_OWNER_CLIENT_IDS={{ codexia_oauth_owner_client_ids }}
{% if codexia_api_audience is defined %}CODEXIA_API_AUDIENCE={{ codexia_api_audience }}
{% endif %}
