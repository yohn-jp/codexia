# Nonsecret Better Auth runtime settings. Secret values are Podman secrets.
CODEXIA_PUBLIC_ORIGIN={{ codexia_public_origin }}
{% if codexia_oidc_issuer is defined %}
CODEXIA_OIDC_ISSUER={{ codexia_oidc_issuer }}
CODEXIA_OIDC_CLIENT_ID={{ codexia_oidc_client_id }}
{% endif %}
CODEXIA_OAUTH_INTROSPECTION_CLIENT_ID={{ codexia_oauth_introspection_client_id }}
{% if codexia_oauth_owner_subject is defined %}
CODEXIA_OAUTH_OWNER_SUBJECT={{ codexia_oauth_owner_subject }}
{% endif %}
CODEXIA_OAUTH_OWNER_CLIENT_IDS={{ codexia_oauth_owner_client_ids }}
{% if codexia_oauth_mcp_client_ids is defined %}
CODEXIA_OAUTH_MCP_CLIENT_IDS={{ codexia_oauth_mcp_client_ids }}
CODEXIA_OAUTH_MCP_PROJECT_ASSIGNMENTS={{ codexia_oauth_mcp_project_assignments | to_json(separators=(',', ':'), sort_keys=true) }}
{% endif %}
{% if codexia_api_audience is defined %}CODEXIA_API_AUDIENCE={{ codexia_api_audience }}
{% endif %}
{% if codexia_auth_passkey_bootstrap_owner_id is defined %}
CODEXIA_AUTH_PASSKEY_BOOTSTRAP_OWNER_EMAIL={{ codexia_auth_passkey_bootstrap_owner_email }}
CODEXIA_AUTH_PASSKEY_BOOTSTRAP_OWNER_ID={{ codexia_auth_passkey_bootstrap_owner_id }}
CODEXIA_AUTH_PASSKEY_BOOTSTRAP_OWNER_NAME={{ codexia_auth_passkey_bootstrap_owner_name }}
{% endif %}
