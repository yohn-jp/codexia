[Unit]
Description=Codexia API backend
# Limit repeated startup failures without weakening the runtime health gate.
StartLimitIntervalSec=120
StartLimitBurst=3
Requires=codexia-db.service
After=network-online.target codexia-db.service

[Container]
Image=CODEXIA_BACKEND_IMAGE
ContainerName=codexia-api
Network=codexia.network
Network=codexia-data.network
Volume=codexia-data.volume:/data
Volume=codexia-history.volume:/history
Secret=codexia-postgres-app-password,type=mount,target=/run/secrets/app-password
Secret=codexia-auth-database-url,type=env,target=CODEXIA_AUTH_DATABASE_URL
Secret=codexia-auth-secret,type=env,target=CODEXIA_AUTH_SECRET
Secret=codexia-oidc-client-secret,type=env,target=CODEXIA_OIDC_CLIENT_SECRET
Secret=codexia-oauth-introspection-client-secret,type=env,target=CODEXIA_OAUTH_INTROSPECTION_CLIENT_SECRET
EnvironmentFile=/home/codexia/.config/codexia-auth/runtime-AUTH_SETTINGS_DIGEST_PLACEHOLDER.env
Environment=CODEXIA_AUTH_MODE=better-auth
Environment=CODEXIA_AUTH_SETTINGS_SHA256=AUTH_SETTINGS_DIGEST_PLACEHOLDER
Environment=CODEXIA_DATABASE_PASSWORD_FILE=/run/secrets/app-password
Environment=CODEXIA_DATABASE_USER=codexia
Environment=CODEXIA_DATABASE_NAME=codexia
Environment=CODEXIA_DATABASE_HOST=codexia-db
Environment=CODEXIA_DATABASE_MIGRATE_ON_START=0
Environment=CODEXIA_TRUST_PROXY=1
Environment=CODEXIA_PROFILE=CODEXIA_BACKEND_PROFILE
Environment=HOST=0.0.0.0
Environment=PORT=3000
Environment=CODEXIA_DATA_DIR=/data
Environment=CODEXIA_USAGE_DIR=/history
ReadOnly=true
Tmpfs=/tmp:rw,nosuid,nodev,noexec,size=144m
NoNewPrivileges=true
DropCapability=all
HealthCmd=node -e 'fetch("http://127.0.0.1:3000/health/ready").then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))'
HealthInterval=30s
# Startup intervals require a startup command. Reuse the exact /health/ready
# probe so Notify=healthy is based on readiness, never an elapsed-time delay.
HealthStartupCmd=node -e 'fetch("http://127.0.0.1:3000/health/ready").then((r) => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))'
HealthStartupInterval=2s
HealthStartupSuccess=1
HealthTimeout=5s
HealthStartPeriod=60s
HealthRetries=3
# A successful systemctl start now proves the real API healthcheck passed.
Notify=healthy

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=120

[Install]
WantedBy=default.target
