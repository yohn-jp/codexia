[Unit]
Description=Cloudflare Tunnel to the Codexia API
Requires=codexia-api.service
After=network-online.target codexia-api.service

[Container]
# cloudflared 2026.11.0, pinned to Cloudflare's published multi-architecture manifest digest.
Image=docker.io/cloudflare/cloudflared@sha256:b94b96edf2c9c4360f8879c8580cfaa99077f19c849ec595ca2f711b27d4f344
ContainerName=codexia-tunnel
Network=codexia.network
Secret=codexia-tunnel-token,type=mount,target=/run/secrets/token
Exec=tunnel --no-autoupdate --metrics 0.0.0.0:2000 run --token-file /run/secrets/token
PublishPort=127.0.0.1:2000:2000/tcp
ReadOnly=true
Tmpfs=/tmp:rw,nosuid,nodev,noexec,size=16m
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=120

[Install]
WantedBy=default.target
