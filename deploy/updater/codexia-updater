#!/bin/sh
set -eu
# This wrapper holds the kernel lock across the Node process, including all child operations.
# The rootless operator installs the repository under /opt/codexia-updater.
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/codexia-updater"
umask 077
mkdir -p "$state_dir"
exec 9>"$state_dir/host.lock"
flock --exclusive --nonblock 9 || exit 75
export CODEXIA_UPDATER_LOCK_DIRECTORY="$state_dir"
export CODEXIA_UPDATER_LOCK_FD=9
exec node /opt/codexia-updater/deploy/updater/standalone-updater.mjs "$@"
