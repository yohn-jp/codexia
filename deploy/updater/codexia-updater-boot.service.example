[Unit]
Description=Restore only the committed Codexia writer from durable state
Requires=codexia-db.service codexia-api-proxy.service
After=codexia-db.service codexia-api-proxy.service
[Service]
Type=oneshot
ExecStart=/bin/sh /opt/codexia-updater/deploy/updater/codexia-updater boot %h/.config/codexia-updater/config.json
TimeoutStartSec=600
RemainAfterExit=yes
[Install]
WantedBy=default.target
