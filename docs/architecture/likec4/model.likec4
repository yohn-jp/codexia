specification {
  element person
  element system
  element container
  element component
  element database
  element externalSystem
  tag client
  tag edge
  tag application
  tag data
  tag operations
  tag storage
}

model {
  author = person 'Owner / author' {
    #client
    metadata { trustBoundary 'client' }
  }

  web = system 'Desktop Web target (React + CodeMirror)' {
    #client
    metadata { trustBoundary 'client' }
  }
  indexedDb = database 'Desktop IndexedDB (recoverable drafts only)' {
    #data
    metadata { trustBoundary 'client' }
  }
  ios = system 'iOS native target (SwiftUI + TextKit 2)' {
    #client
    metadata { trustBoundary 'client' }
  }
  iosJournal = database 'iOS protected local draft journal' {
    #data
    metadata { trustBoundary 'client' }
  }
  externalAi = system 'External AI / MCP client' {
    #client
    metadata { trustBoundary 'client' }
  }

  edge = system 'Cloudflare public edge' {
    #edge
    metadata { trustBoundary 'edge' }
    workers = container 'Workers Static Assets + Access' {
      #edge
      metadata { trustBoundary 'edge' }
    }
    tunnel = container 'Shared Tunnel: product API ingress (target)' {
      #edge
      metadata { trustBoundary 'edge' }
    }
  }

  codexia = system 'Codexia VM' {
    #application
    metadata { trustBoundary 'application-host' }
    publicationGate = component 'Independent host-local product publication gate (target)' {
      #application
      metadata { trustBoundary 'application-host' }
    }
    fastify = container 'Fastify API admission' {
      #application
      metadata { trustBoundary 'application' }
      betterAuth = component 'Better Auth / OAuth' {
        #application
        metadata { trustBoundary 'application' }
      }
      mcp = component 'MCP adapter (stdio / Streamable HTTP)' {
        #application
        metadata { trustBoundary 'application' }
      }
      core = component 'Shared domain actions and Core' {
        #application
        metadata { trustBoundary 'application' }
      }
      modules = component 'Trusted optional module runtime (read / compute / propose)' {
        #application
        metadata { trustBoundary 'application' }
      }
      persistence = component 'PostgreSQL persistence adapter' {
        #application
        metadata { trustBoundary 'application' }
      }
    }
    postgres = database 'PostgreSQL (sole canonical data authority)' {
      #data
      metadata { trustBoundary 'data' }
    }
    history = database 'Legacy host history volume (until DB consolidation acceptance)' {
      #data
      metadata { trustBoundary 'data' }
    }
    podman = container 'Rootless Podman Quadlet host services' {
      #operations
      metadata { trustBoundary 'host-operations' }
    }
    ssh = component 'Pinned SSH host entry' {
      #operations
      metadata { trustBoundary 'host-operations' }
    }
    backupExecutor = component 'Protected backup.sh executor + host lock' {
      #operations
      metadata { trustBoundary 'host-operations' }
    }
  }

  operations = system 'Protected GitHub Actions deployment path' {
    #operations
    metadata { trustBoundary 'operations' }
    workflow = container 'GitHub Actions protected admission' {
      #operations
      metadata { trustBoundary 'operations' }
      verify = component 'Verify and exact-source certificate' {
        #operations
        metadata { trustBoundary 'operations' }
      }
      release = component 'Backend release workflow (digest publication)' {
        #operations
        metadata { trustBoundary 'operations' }
      }
      admission = component 'Protected deployment admission' {
        #operations
        metadata { trustBoundary 'operations' }
      }
    }
    managementIngress = container 'Same Cloudflare Tunnel: dedicated Access Service Auth SSH ingress (target)' {
      #operations
      metadata { trustBoundary 'operations' }
    }
    ansible = component 'Pinned SSH and Ansible desired state' {
      #operations
      metadata { trustBoundary 'operations' }
    }
  }
  offsite = system 'S3-compatible off-VM storage' {
    #storage
    metadata { trustBoundary 'offsite-storage' }
    s3 = externalSystem 'Age-encrypted backup objects' {
      #storage
      metadata { trustBoundary 'offsite-storage' }
    }
  }
  github = externalSystem 'GitHub main source repository' {
    #operations
    metadata { trustBoundary 'operations' }
  }
  ghcr = externalSystem 'GHCR Full image by digest' {
    #operations
    metadata { trustBoundary 'operations' }
  }

  author -> web 'Writes through the authoring UI'
  web -> indexedDb 'Stores recoverable local drafts only'
  ios -> iosJournal 'Stores recoverable protected local drafts only'
  web -> edge.workers 'Loads static UI behind Access'
  web -> edge.tunnel 'Calls the authenticated API'
  ios -> edge.tunnel 'Calls the authenticated API'
  externalAi -> codexia.fastify.mcp 'Uses assigned MCP read / compute / propose scopes'
  edge.tunnel -> codexia.publicationGate 'Routes product traffic only to the gated endpoint'
  codexia.publicationGate -> codexia.fastify 'Forwards product traffic only while admitted'
  codexia.fastify.mcp -> codexia.fastify.core 'Uses shared authorized domain actions'
  codexia.fastify.core <-> codexia.fastify.modules 'Reads, computes and proposes through trusted capabilities'
  codexia.fastify.core -> codexia.fastify.persistence 'Uses the PostgreSQL persistence boundary'
  codexia.fastify.persistence -> codexia.postgres 'Reads and commits canonical project data; target includes durable user and operations state'
  codexia.fastify.betterAuth -> codexia.postgres 'Stores authentication state'

  github -> operations.workflow.verify 'Provides the main source for verification'
  operations.workflow.verify -> operations.workflow.release 'Provides the exact-source certificate'
  operations.workflow.release -> ghcr 'Publishes the immutable Full image by digest'
  ghcr -> operations.workflow.admission 'Supplies the digest-pinned image'
  operations.workflow.admission -> operations.ansible 'Runs the admitted deployment workflow'
  operations.workflow -> operations.ansible 'Runs the admitted deployment workflow'
  operations.ansible -> operations.managementIngress 'Uses dedicated protected Environment Service Auth and pinned SSH'
  operations.managementIngress -> codexia.ssh 'Forwards only SSH independently of product publication'
  operations.ansible -> codexia.podman 'Converges the protected Quadlet desired state'
  codexia.podman -> codexia.postgres 'Runs PostgreSQL with preserved volumes'
  codexia.ssh -> codexia.backupExecutor 'Invokes the protected host-locked backup path'
  codexia.backupExecutor -> codexia.postgres 'Reads a quiesced PostgreSQL backup source'
  codexia.backupExecutor -> codexia.history 'Current backup includes host history until replacement acceptance'
  codexia.backupExecutor -> offsite.s3 'Uploads and re-reads age-encrypted ciphertext'
}

views {
  view architecture {
    title 'Codexia system context, containers, and trust boundaries'
    include *
    include edge.**
    include codexia.**
    include operations.**
    include offsite.**
  }

  view operations-topology {
    title 'Protected deployment topology'
    include github
    include ghcr
    include operations.**
    include edge.tunnel
    include codexia.publicationGate
    include codexia.ssh
    include codexia.backupExecutor
    include codexia.podman
    include codexia.postgres
    include codexia.history
    include offsite.**
  }
}
